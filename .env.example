# Copy to .env for local development. Never commit a real .env file.
#
# --- Local (SQLite + in-process worker) -------------------------------------------------
FORECASTOPS_ENVIRONMENT=development
FORECASTOPS_DATABASE_URL=sqlite:///./data/local/forecastops.db
FORECASTOPS_DATA_DIR=./data/local
FORECASTOPS_EXECUTION_MODE=thread
FORECASTOPS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FORECASTOPS_COOKIE_SECURE=false
FORECASTOPS_LOG_LEVEL=INFO

# --- Docker Compose (PostgreSQL + Redis + RQ) -------------------------------------------
# FORECASTOPS_DATABASE_URL=postgresql+psycopg://forecastops:forecastops-dev@db:5432/forecastops
# FORECASTOPS_REDIS_URL=redis://redis:6379/0
# FORECASTOPS_EXECUTION_MODE=rq
POSTGRES_PASSWORD=forecastops-dev

# Fictional demo login. Change it for any shared deployment.
FORECASTOPS_DEMO_PASSWORD=planning-demo-2024

# --- Limits (defaults shown) -------------------------------------------------------------
# FORECASTOPS_MAX_UPLOAD_BYTES=5242880
# FORECASTOPS_MAX_UPLOAD_ROWS=200000
# FORECASTOPS_MAX_SERIES=200
# FORECASTOPS_MAX_HORIZON_DAYS=90
# FORECASTOPS_JOB_TIMEOUT_SECONDS=300
# FORECASTOPS_SESSION_TTL_HOURS=12
